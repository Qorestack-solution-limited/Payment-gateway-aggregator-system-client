generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum GatewayProvider {
  STRIPE
  PAYPAL
  ADYEN
  SQUARE
  FLUTTERWAVE
  PAYSTACK
  OTHER
}

enum GatewayStatus {
  ACTIVE
  INACTIVE
  WARNING
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ApiKeyType {
  LIVE
  TEST
}

enum NotificationType {
  PAYMENT
  ALERT
  INFO
  SUCCESS
  WARNING
}

enum RoutingStrategy {
  PRIORITY
  SUCCESS_RATE
  ROUND_ROBIN
  COST
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  GATEWAY_CREATED
  GATEWAY_UPDATED
  GATEWAY_DELETED
  GATEWAY_TOGGLED
  GATEWAY_VALIDATED
  GATEWAY_SYNCED
  TRANSACTION_STATUS_UPDATED
  TRANSACTION_REFUNDED
  API_KEY_GENERATED
  API_KEY_REVOKED
  API_KEY_DELETED
  WEBHOOK_CREATED
  WEBHOOK_DELETED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  PLAN_CHANGED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(cuid())
  firstName      String
  lastName       String
  email          String         @unique
  password       String
  role           Role           @default(USER)
  avatarUrl      String?
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  twoFactorSecret         String?
  twoFactorEnabled        Boolean        @default(false)
  notificationPreferences Json?
  refreshTokens           RefreshToken[]
  passwordResets   PasswordReset[]
  notifications    Notification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([email])
}

model Organization {
  id                   String               @id @default(cuid())
  name                 String
  companySize          String?
  industry             String?
  website              String?
  plan                 Plan                 @default(FREE)
  baseCurrency         String               @default("NGN")
  users                User[]
  gateways             Gateway[]
  transactions         Transaction[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  providerWebhookEvents ProviderWebhookEvent[]
  gatewaySyncRuns      GatewaySyncRun[]
  paymentLinks         PaymentLink[]
  routingRules         RoutingRule[]
  settlements          Settlement[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Gateway {
  id                   String               @id @default(cuid())
  name                 String
  provider             GatewayProvider
  type                 String
  status               GatewayStatus        @default(ACTIVE)
  publicKey            String?
  secretKey            String?
  webhookSecret        String?
  uptime               Float                @default(100)
  lastSyncedAt         DateTime?
  lastSyncStatus       String?
  lastSyncMessage      String?
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  providerWebhookEvents ProviderWebhookEvent[]
  syncRuns             GatewaySyncRun[]
  paymentLinks         PaymentLink[]
  routingRules         RoutingRule[]
  settlements          Settlement[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([organizationId])
}

model Transaction {
  id                    String                @id @default(cuid())
  reference             String                @unique @default(cuid())
  providerReference     String?
  providerTransactionId String?
  refundId              String?
  providerStatus        String?
  providerPayload       Json?
  syncedFromProvider    Boolean               @default(false)
  lastSyncedAt          DateTime?
  amount                Decimal               @db.Decimal(14, 2)
  currency              String                @default("NGN")
  status                TransactionStatus     @default(PENDING)
  customerName          String
  customerEmail         String
  description           String?
  metadata              Json?
  gatewayId             String
  gateway               Gateway               @relation(fields: [gatewayId], references: [id])
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerWebhookEvents ProviderWebhookEvent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([organizationId])
  @@index([gatewayId])
  @@index([status])
  @@index([createdAt])
}

model ProviderWebhookEvent {
  id             String        @id @default(cuid())
  provider       GatewayProvider
  event          String
  status         String
  signature      String?
  reference      String?
  payload        Json?
  rawBody        String?
  errorMessage   String?
  gatewayId      String?
  gateway        Gateway?      @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  transactionId  String?
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  receivedAt     DateTime      @default(now())

  @@index([gatewayId])
  @@index([transactionId])
  @@index([organizationId])
  @@index([provider])
  @@index([receivedAt])
}

model GatewaySyncRun {
  id             String       @id @default(cuid())
  status         String
  imported       Int          @default(0)
  updated        Int          @default(0)
  totalFetched   Int          @default(0)
  message        String?
  fromDate       String?
  toDate         String?
  gatewayId      String
  gateway        Gateway      @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([gatewayId])
  @@index([organizationId])
  @@index([startedAt])
}

model IdempotencyRequest {
  id             String   @id @default(cuid())
  key            String
  path           String
  organizationId String
  requestHash    String
  response       Json
  createdAt      DateTime @default(now())

  @@unique([organizationId, key, path])
  @@index([organizationId])
  @@index([createdAt])
}

model ApiKey {
  id             String     @id @default(cuid())
  name           String
  key            String     @unique
  type           ApiKeyType @default(TEST)
  isActive       Boolean    @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastUsedAt     DateTime?
  requestCount   Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([organizationId])
  @@index([key])
}

model Webhook {
  id             String            @id @default(cuid())
  url            String
  events         String[]
  isActive       Boolean           @default(true)
  secret         String
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  statusCode   Int
  response     String?
  retryCount   Int       @default(0)
  nextRetryAt  DateTime?
  deliveredAt  DateTime  @default(now())

  @@index([webhookId])
  @@index([nextRetryAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  actorId        String
  actorEmail     String
  organizationId String
  resourceType   String
  resourceId     String?
  description    String?
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
  @@index([resourceType])
}

model PaymentLink {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  description    String?
  amount         Decimal?     @db.Decimal(14, 2)
  currency       String       @default("NGN")
  isActive       Boolean      @default(true)
  gatewayId      String?
  gateway        Gateway?     @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redirectUrl    String?
  maxUses        Int?
  useCount       Int          @default(0)
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([slug])
}

model RoutingRule {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  priority         Int             @default(0)
  isActive         Boolean         @default(true)
  strategy         RoutingStrategy @default(PRIORITY)
  currency         String?
  minAmount        Decimal?        @db.Decimal(14, 2)
  maxAmount        Decimal?        @db.Decimal(14, 2)
  gatewayId        String?
  gateway          Gateway?        @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  fallbackGatewayId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([priority])
}

model Settlement {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gatewayId            String
  gateway              Gateway          @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  providerSettlementId String?
  amount               Decimal          @db.Decimal(14, 2)
  currency             String           @default("NGN")
  status               SettlementStatus @default(PENDING)
  bankAccount          String?
  settledAt            DateTime?
  expectedAt           DateTime?
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organizationId])
  @@index([gatewayId])
  @@index([createdAt])
  @@index([status])
}
